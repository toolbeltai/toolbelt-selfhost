# Toolbelt on x86 + NVIDIA GPU — environment. `./setup.sh` generates a real .env
# from this template (fresh secrets, detected HOST_IP). Do not commit .env.

# --- Images -----------------------------------------------------------------
TB_REGISTRY=ghcr.io/toolbeltai/toolbelt
# The tested, public image build. Multi-arch (arm64 + amd64) — the right layer
# is selected automatically for your box. You normally don't change this.
TB_TAG=v0.2.94

# --- Networking -----------------------------------------------------------
# An address the browser AND the containers both reach (the box's LAN IP).
# NOT 127.0.0.1 — it is baked into the OIDC redirect and the Ollama URL.
# On a box that runs offline it must still exist with the network unplugged:
# use a fixed (static) LAN IP.
HOST_IP=127.0.0.1

# --- Where the models are served --------------------------------------------
# true  = setup.sh runs Ollama in a container on this box, pulls and warms the
#         models (the default).
# false = you already serve models (Ollama installed on Windows, vLLM, ...):
#         setup.sh leaves Ollama alone and everything uses the URLs below.
LOCAL_OLLAMA=true
# OpenAI-compatible endpoints (.../v1). Use an address the containers reach:
# HOST_IP, not localhost.
LLM_BASE_URL=http://${HOST_IP}:11434/v1
LLM_API_KEY=ollama
EMBED_BASE_URL=${LLM_BASE_URL}
EMBED_API_KEY=${LLM_API_KEY}

# --- Models (served by Ollama on the NVIDIA GPU, or by your server) ---------
# With LOCAL_OLLAMA=false use the names your server knows them by.
# Set these BEFORE the first ./setup.sh: atlas records the chat and embedding
# model on its first start only. To change them later use Admin -> Settings
# (and note vectors from different embedders don't mix: a new embedder means
# re-embedding). Gemma 4 26B-A4B: long native context (Ollama serves 65,536
# tokens, set by setup.sh). The QAT build is 14.4 GB of weights and fits a 20 GB card next to the embedder.
SLM_CHAT_MODEL=gemma4:26b-a4b-it-qat
# Qwen3-Embedding-4B, 2560-dimensional vectors (~2.5 GB).
SLM_EMBED_MODEL=qwen3-embedding:4b
SLM_EMBED_DIM=2560

# --- Knowledge-graph encoder (relex) ----------------------------------------
# cuda = on the GPU (sub-second/doc); cpu = on the CPU (~1-2 s/doc) so the
# GPU's memory goes to the models. setup.sh picks cpu on cards under 30 GB
# (a 20 GB RTX 4000 Ada, a 24 GB A10G) and cuda on bigger ones.
RELEX_DEVICE=cuda
# 1 = relex never tries huggingface.co (its model is already cached in the
# relex-models volume). Optional on an offline box; it falls back to the cache.
HF_HUB_OFFLINE=0

# --- Kinetica ----------------------------------------------------------------
# Hard memory cap for the Kinetica container (10g suits a 24 GB WSL2 VM or a 16 GB+ server). Give it
# about 40% of the machine's RAM, leaving the rest to docling, relex, Ollama.
KINETICA_MEM_LIMIT=10g
# RAM tier per rank, in bytes. Blank = a third of KINETICA_MEM_LIMIT, split
# over the ranks; queries need the rest as working memory, which the tier does
# not cap. Set it only if you know you need more data in RAM.
KINETICA_RAM_TIER_LIMIT=
# Kinetica license key. Blank = the free developer edition.
KINETICA_LICENSE_KEY=

# --- Enterprise license (optional) ----------------------------------------
# Blank = community mode. Paste an Enterprise key here to lift its limits,
# then re-run ./setup.sh (or: docker compose up -d atlas). See license-key docs.
TOOLBELT_LICENSE=

# --- Secrets — GENERATE YOUR OWN (setup.sh does this) ---------------------
TOOLBELT_SERVICE_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
# Shared Kinetica handshake plaintext — Kinetica encrypts it; atlas presents it.
TB_HANDSHAKE=CHANGE_ME
# RSA keypair (single-line PEM bodies) — signs/validates agent tokens (RS512).
ACCESS_TOKEN_PRIVATE_KEY=CHANGE_ME
ACCESS_TOKEN_PUBLIC_KEY=CHANGE_ME
