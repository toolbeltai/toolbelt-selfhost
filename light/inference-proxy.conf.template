# OpenAI-compatible pass-through to the hosted model endpoint. nginx fills ${...} from the container env.
# Adds the Cloudflare Access service-token headers; streaming responses pass straight through.
server {
    listen 8080;
    client_max_body_size 64m;          # large embedding batches
    location / {
        proxy_pass https://${INFERENCE_HOST};
        proxy_ssl_server_name on;
        proxy_set_header Host ${INFERENCE_HOST};
        proxy_set_header CF-Access-Client-Id ${INFERENCE_CLIENT_ID};
        proxy_set_header CF-Access-Client-Secret ${INFERENCE_CLIENT_SECRET};
        proxy_set_header Authorization "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
