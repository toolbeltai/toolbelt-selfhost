# Toolbelt light (CPU box, hosted models) — environment. `./setup.sh` generates a real .env
# from this template (fresh secrets, detected HOST_IP). Do not commit .env.

# --- Images -----------------------------------------------------------------
TB_REGISTRY=ghcr.io/toolbeltai/toolbelt
# A released, tested image build. Multi-arch (relex is x86 only).
TB_TAG=v0.2.76

# --- Networking -----------------------------------------------------------
# An address the browser AND the containers both reach (the box's LAN IP).
# NOT 127.0.0.1 — it is baked into the OIDC redirect and the agent connect URL.
HOST_IP=127.0.0.1
# Host networking (e.g. AWS with an instance-metadata hop limit of 1):
#   COMPOSE_FILE=docker-compose.yml:host-network.yml  and  KINETICA_URL=http://127.0.0.1:9191
COMPOSE_FILE=docker-compose.yml

# --- Kinetica -------------------------------------------------------------
# Bundled (default). To use an existing Kinetica instead, empty COMPOSE_PROFILES,
# point KINETICA_URL at it, and set TB_HANDSHAKE + the admin login to match it
# (see README: it needs external authentication on, with that handshake key).
COMPOSE_PROFILES=bundled-kinetica
KINETICA_URL=http://kinetica:9191
# The UI login. The bundled Kinetica sets admin / Admin123! on first boot.
KINETICA_ADMIN_USER=admin
KINETICA_ADMIN_PASSWORD=Admin123!

# --- Hosted models ------------------------------------------------------------
# Toolbelt-hosted inference: ask Toolbelt for an API key. Any OpenAI-compatible
# endpoint that takes `Authorization: Bearer <key>` works the same way.
# Only model calls leave this box: questions, document chunks being embedded, and
# the context retrieved to answer. Nothing is stored on the inference side.
INFERENCE_BASE_URL=https://inference.toolbelt.ai/v1
INFERENCE_API_KEY=
CHAT_MODEL=chat
EMBED_MODEL=embeddings
# Must match the embedding model's output size or ingestion fails.
EMBED_DIM=2560

# --- Enterprise license (optional) ----------------------------------------
# Blank = community mode. Paste an Enterprise key here to lift its limits,
# then re-run ./setup.sh (or: docker compose up -d atlas). See license-key docs.
TOOLBELT_LICENSE=

# --- Secrets — GENERATE YOUR OWN (setup.sh does this) ---------------------
TOOLBELT_SERVICE_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
# Shared Kinetica handshake plaintext — Kinetica encrypts it; atlas presents it.
# With an existing Kinetica, set this to the handshake key it is configured with.
TB_HANDSHAKE=CHANGE_ME
# RSA keypair (single-line PEM bodies) — signs/validates agent tokens (RS512).
ACCESS_TOKEN_PRIVATE_KEY=CHANGE_ME
ACCESS_TOKEN_PUBLIC_KEY=CHANGE_ME
